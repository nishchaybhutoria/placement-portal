#!/usr/bin/env bash
set -euo pipefail

msg="$1"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

python3 - "$msg" "$tmp" <<'PY'
import re
import sys

src, dst = sys.argv[1:3]

with open(src) as f:
    lines = f.readlines()

lines = [
    line for line in lines
    if "Claude-Session:" not in line
    and "claude.ai/code/session_" not in line
]

text = "".join(lines)
text = re.sub(r"\n{3,}", "\n\n", text)
text = text.rstrip() + "\n"

with open(dst, "w") as f:
    f.write(text)
PY

mv "$tmp" "$msg"
