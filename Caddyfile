{
	admin localhost:2019
}

(api_proxy) {
	reverse_proxy api:8000 {
		# The edge overwrites caller input so one trusted UUID joins Caddy and API logs.
		header_up X-Request-ID {http.request.uuid}
	}
}

{$DOMAIN:cdsportal.example.edu} {
	tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/server.key
	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Caddy redacts standard credentials; CSRF is application-specific.
				request>headers>X-Csrf delete
				# Keep the route path for operations while dropping all query values.
				request>uri regexp "^([^?]*).*$" "${1}"
			}
		}
	}

	# OAuth callbacks contain one-time codes and state in the query string, while
	# login responses contain state in Location. FastAPI still emits a safe,
	# route-templated completion log for these requests.
	log_skip /portal/auth/*

	redir /portal /portal/ 308
	redir /mock /mock/ 308

	# FastAPI keeps its internal root-relative routes. Strip only the external
	# portal mount before proxying so its OpenAPI and route contracts stay stable.
	handle /portal/api/* {
		uri strip_prefix /portal
		import api_proxy
	}

	handle /portal/auth/* {
		uri strip_prefix /portal
		import api_proxy
	}

	handle /portal/me {
		uri strip_prefix /portal
		import api_proxy
	}

	# Keep health endpoints at their established paths for external monitoring.
	handle /healthz {
		import api_proxy
	}

	handle /readyz {
		import api_proxy
	}

	# The portal SPA falls back to its own index rather than the common landing page.
	handle_path /portal/* {
		root * /srv/portal
		try_files {path} /index.html
		file_server
	}

	# The separately managed mock Node application runs under PM2 on the host.
	# handle_path removes /mock before forwarding to its root-relative routes.
	handle_path /mock/* {
		reverse_proxy host.docker.internal:5000
	}

	handle {
		root * /srv/common
		try_files {path} /index.html
		file_server
	}
}
