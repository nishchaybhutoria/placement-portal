# Copy to .env and chmod 600. REQUIRED/CONDITIONAL values must be replaced.

# PostgreSQL / application database
POSTGRES_USER=cds
POSTGRES_DB=cds
POSTGRES_PORT=5432
API_PORT=8000
POSTGRES_PASSWORD=REQUIRED-random-migration-and-backup-secret
CDS_APP_DB_PASSWORD=REQUIRED-different-random-runtime-secret
POSTGRES_MONITOR_PASSWORD=REQUIRED-third-random-read-only-monitor-secret

# Compose derives the four URLs below from the database settings. These values
# are only examples for running backend tools directly outside Compose.
MIGRATION_DATABASE_URL=postgresql+asyncpg://cds:REQUIRED@127.0.0.1:5432/cds
DATABASE_URL=postgresql+asyncpg://cds_app:REQUIRED@127.0.0.1:5432/cds
QUEUE_SCHEMA_DATABASE_URL=postgresql://cds:REQUIRED@127.0.0.1:5432/cds
PROCRASTINATE_DATABASE_URL=postgresql://cds_app:REQUIRED@127.0.0.1:5432/cds

# Public endpoint, sessions, and identity -- all REQUIRED except the documented
# secure defaults. A real DNS name is required for Caddy TLS and Google OAuth.
DOMAIN=REQUIRED-careers.example.edu
TLS_DIR=/home/cdsuser/cds-secrets/tls
BASE_URL=REQUIRED-https://careers.example.edu
# Also required by `make migrate` / `make queue-schema`: the Procrastinate
# schema step loads the worker app, which constructs the settings. Any
# 32-character value satisfies that step.
SESSION_SECRET=REQUIRED-at-least-32-random-characters
SESSION_COOKIE_SECURE=1
GOOGLE_CLIENT_ID=REQUIRED
GOOGLE_CLIENT_SECRET=REQUIRED
ALLOWED_DOMAIN=example.edu
DEV_LOGIN=0
SEED_ADMIN_EMAIL=REQUIRED-admin@example.edu

# Notifications. "console" is the deliberate safe default for rehearsal. For
# SES, change the backend and provide the conditional credentials and sender below.
# SES_REPLY_TO optionally accepts a comma-separated list of reply addresses.
NOTIFICATION_BACKEND=console
SES_REGION=ap-south-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SENDER=
SES_REPLY_TO=
# Development email review. Leave at 0 in production. Setting
# it to 1 needs APP_ENV=development|test and NOTIFICATION_BACKEND=console as
# well; with APP_ENV=production, or on any other backend, the API and worker
# refuse to start. That hard failure is deliberate -- the flag prints rendered
# recipients, subjects and bodies to stdout, which production telemetry must
# never carry.
DEV_EMAIL_OUTPUT=0
ALERT_RECIPIENT=REQUIRED-monitored-operations-address@example.edu
ALERT_SECRETS_DIR=/home/cdsuser/cds-secrets/alertmanager

# Operational telemetry. RELEASE is set to the deployed Git SHA for every
# release; observability data and Docker's data root live on the large /home LV.
APP_ENV=production
# `make deploy` exports this from `git rev-parse HEAD`, so it is correct
# without being maintained. Set it here only for containers you run by hand.
RELEASE=REQUIRED-deployed-git-sha
LOG_LEVEL=INFO
DOCKER_DATA_ROOT=/home/docker-data
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000

# Backups. Production keeps the remote enabled. Set exactly one of TOKEN or
# SERVICE_ACCOUNT_CREDENTIALS; both are secrets.
BACKUP_REMOTE_ENABLED=1
RCLONE_ROOT=gdrive:cds
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive
RCLONE_CONFIG_GDRIVE_ROOT_FOLDER_ID=
RCLONE_CONFIG_GDRIVE_TOKEN=
RCLONE_CONFIG_GDRIVE_SERVICE_ACCOUNT_CREDENTIALS=
DUMP_RETENTION_DAYS=7
BASE_RETENTION_COUNT=7
WORKER_CONCURRENCY=4

# Local test harness only; not production deployment inputs.
POSTGRES_TEST_DB=cds_test
POSTGRES_TEST_PORT=5433
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://cds:cds@127.0.0.1:5433/cds_test
TEST_DATABASE_URL=postgresql+asyncpg://cds_app:cds_app@127.0.0.1:5433/cds_test
TEST_QUEUE_SCHEMA_DATABASE_URL=postgresql://cds:cds@127.0.0.1:5433/cds_test
TEST_PROCRASTINATE_DATABASE_URL=postgresql://cds_app:cds_app@127.0.0.1:5433/cds_test
