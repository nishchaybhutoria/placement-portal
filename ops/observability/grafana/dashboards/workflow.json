{
  "annotations": {"list": []},
  "description": "Command executor and background-worker health using bounded application metrics and structured logs.",
  "editable": false,
  "graphTooltip": 1,
  "links": [{"asDropdown": true, "includeVars": false, "keepTime": true, "tags": ["cds"], "title": "CDS dashboards", "type": "dashboards"}],
  "panels": [
    {
      "type": "stat", "title": "Worker target", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(up{job=\"cds-worker\"}) or vector(0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "Down"}, "1": {"text": "Up"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat", "title": "Command error rate", "description": "Executor errors per second over ten minutes.", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(cds_command_executions_total{outcome=\"error\"}[10m])) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 4, "unit": "ops", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.000001}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat", "title": "Real command rate", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(cds_command_executions_total{dry_run=\"false\"}[5m])) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "ops"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat", "title": "Overall command p95", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(cds_command_duration_seconds_bucket[10m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 2.5}, {"color": "red", "value": 10}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries", "title": "Command execution rate by outcome", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (outcome) (rate(cds_command_executions_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "type": "timeseries", "title": "Preview versus real commands", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (dry_run) (rate(cds_command_executions_total[5m]))", "legendFormat": "preview={{dry_run}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "type": "timeseries", "title": "Commands by name", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(15, sum by (command) (rate(cds_command_executions_total[5m])))", "legendFormat": "{{command}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 12}
    },
    {
      "type": "timeseries", "title": "Command p95 duration by name", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(15, histogram_quantile(0.95, sum by (command, le) (rate(cds_command_duration_seconds_bucket[10m]))))", "legendFormat": "{{command}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 12}
    },
    {
      "type": "timeseries", "title": "Command errors by name", "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (command) (rate(cds_command_executions_total{outcome=\"error\"}[10m]))", "legendFormat": "{{command}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}
    },
    {
      "type": "timeseries", "title": "Worker job completions", "description": "Successful and failed Procrastinate completion messages derived from worker logs.", "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {"expr": "sum(count_over_time({compose_project=\"cds-portal\", service=\"worker\"} |= \"ended with status: Success\" [$__auto]))", "legendFormat": "success", "queryType": "range", "refId": "A"},
        {"expr": "sum(count_over_time({compose_project=\"cds-portal\", service=\"worker\"} |~ \"ended with status: (Failed|Aborted)\" [$__auto]))", "legendFormat": "failed/aborted", "queryType": "range", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}
    },
    {
      "type": "logs", "title": "Worker errors", "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{compose_project=\"cds-portal\", service=\"worker\", level=~\"(?i)error|critical|warning|warn\"}", "refId": "A"}],
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 29}
    },
    {
      "type": "logs", "title": "Periodic task activity", "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{compose_project=\"cds-portal\", service=\"worker\"} |~ \"Periodic job|Consistency check completed|reminder scan completed\"", "refId": "A"}],
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 29}
    },
    {
      "type": "logs", "title": "Executor failures", "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{compose_project=\"cds-portal\"} | json | logger=\"app.core.executor\" | outcome=\"error\"", "refId": "A"}],
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 38}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": ["cds", "workflow"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "CDS Workflow and Worker",
  "uid": "cds-workflow",
  "version": 1
}
